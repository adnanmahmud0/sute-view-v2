# ==============================================================================
#                  FULLSTACK TURBOREPO MONOREPO CONFIGURATION
# ==============================================================================
# Single Root Environment File for both Frontend (@repo/web) and Backend (@repo/api).
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: Never commit .env with production credentials to version control.
# ==============================================================================


# ==============================================================================
# 1. SHARED / ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: In Next.js, NODE_ENV is managed automatically by the runtime (dev/build/test).
# Uncomment only if needed for standalone scripts:
# NODE_ENV=development


# ==============================================================================
# 2. FRONTEND CONFIGURATION (@repo/web - Next.js)
# ==============================================================================
# Public variables exposed to the browser MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_GA_ID=

# Next.js Build & Bundle Analyzer (optional: true | false)
ANALYZE=false


# ==============================================================================
# 3. BACKEND SERVER CONFIGURATION (@repo/api - Express.js)
# ==============================================================================
PORT=5000
IP_ADDRESS=localhost
# Swagger / OpenAPI documentation (auto-enabled in development; set true to force)
ENABLE_API_DOCS=true

# Branding & Metadata
PROJECT_NAME="Turborepo Fullstack Starter"
BRAND_LOGO=


# ==============================================================================
# 4. DATABASE CONFIGURATION (Prisma ORM)
# ==============================================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fullstack_db?schema=public"


# ==============================================================================
# 5. AUTHENTICATION & SECURITY
# ==============================================================================
# Bcrypt hashing rounds
BCRYPT_SALT_ROUNDS=10

# Access Token (short-lived)
JWT_SECRET=super_secret_jwt_access_key_replace_in_production_32chars
JWT_EXPIRE_IN=7d

# Refresh Token (long-lived)
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_replace_in_production_32chars
JWT_REFRESH_EXPIRE_IN=90d

# Express Session Secret
SESSION_SECRET=super_secret_session_key_replace_in_production_32chars

# Default Super Admin Seed / Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password123


# ==============================================================================
# 6. OAUTH CONFIGURATION (Passport.js)
# ==============================================================================
# Frontend redirect target after successful OAuth authentication
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Google OAuth (https://console.cloud.google.com)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/oauth/google/callback

# Facebook OAuth (Template ready - https://developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/oauth/facebook/callback

# GitHub OAuth (Template ready - https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/oauth/github/callback


# ==============================================================================
# 7. EMAIL SERVICE (Nodemailer / SMTP)
# ==============================================================================
EMAIL_FROM=noreply@example.com
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-specific-password
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com


# ==============================================================================
# 8. THIRD-PARTY SERVICES & INTEGRATIONS (Optional)
# ==============================================================================
# Stripe Payments
STRIPE_API_SECRET=
WEBHOOK_SECRET=
SUCCESS_URL=http://localhost:3000/success

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FCM_SERVER_KEY=
SENDER_ID=
FCM_SERVICE_ACCOUNT_BASE64=

# Apple In-App Purchase
APPLE_SHARED_SECRET=

# Google Play In-App Purchase
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PACKAGE_NAME=
