{
  "name": "@repo/admin",
  "version": "16.0.0",
  "private": true,
  "description": "Production-ready Next.js 16 Super Admin portal with Tailwind CSS 4, React 19, and Shadcn UI.",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 8002",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 8002",
    "clean": "rimraf .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache && prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
