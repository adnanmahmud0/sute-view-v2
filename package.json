{
  "name": "nextjs-expressjs-turborepo-boilerplate",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Production-ready Turborepo monorepo starter featuring Next.js 16 frontend and Express.js + Prisma backend.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "dev:api": "turbo dev --filter=@repo/api",
    "build": "turbo build",
    "build:web": "turbo build --filter=@repo/web",
    "build:admin": "turbo build --filter=@repo/admin",
    "build:api": "turbo build --filter=@repo/api",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@repo/web",
    "lint:admin": "turbo lint --filter=@repo/admin",
    "lint:api": "turbo lint --filter=@repo/api",
    "typecheck": "turbo typecheck",
    "typecheck:web": "turbo typecheck --filter=@repo/web",
    "typecheck:admin": "turbo typecheck --filter=@repo/admin",
    "typecheck:api": "turbo typecheck --filter=@repo/api",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
